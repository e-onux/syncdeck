		<string>com.sidrelabs.syncdeck.sync</string>
		<string>com.sidrelabs.syncdeck.refresh</string>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
		<string>de</string>
		<string>es</string>
		<string>nl</string>
		<string>zh-Hans</string>
