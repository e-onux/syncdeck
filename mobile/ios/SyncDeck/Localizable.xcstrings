    "Removal from iPhone was not confirmed; nothing was deleted.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'dan kaldırma onaylanmadı; hiçbir şey silinmedi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen vom iPhone wurde nicht bestätigt; nichts wurde gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confirmó quitar del iPhone; no se eliminó nada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen van iPhone is niet bevestigd; er is niets verwijderd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未确认从 iPhone 移除；没有删除任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone からの削除が確認されなかったため、何も削除していません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление с iPhone не подтверждено; ничего не удалено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد الإزالة من الـ iPhone؛ لم يُحذف أي شيء."
          }
        }
      }
    },
