    "Only adds files and never deletes anything. Safe, with no irreversible data loss.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları yalnızca ekler, hiçbir şeyi silmez. Güvenli, geri dönüşsüz veri kaybı yok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt nur Dateien hinzu und löscht nie etwas. Sicher, ohne unwiderruflichen Datenverlust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo añade archivos y nunca elimina nada. Seguro, sin pérdida de datos irreversible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt alleen bestanden toe en verwijdert nooit iets. Veilig, zonder onomkeerbaar dataverlies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只添加文件，从不删除任何内容。安全，不会造成不可逆的数据丢失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを追加するだけで、何も削除しません。安全で、取り返しのつかないデータ損失はありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только добавляет файлы и ничего не удаляет. Безопасно, без необратимой потери данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف الملفات فقط ولا يحذف أي شيء. آمن، دون فقدان بيانات لا رجعة فيه."
          }
        }
      }
    },
    "Only after each file is verified in the cloud": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca her dosya bulutta doğrulandıktan sonra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst wenn jede Datei in der Cloud geprüft ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando cada archivo está verificado en la nube"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas nadat elk bestand in de cloud is gecontroleerd"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在每个文件都在云端通过校验之后"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ファイルがクラウドで検証された後のみ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только после проверки каждого файла в облаке"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط بعد التحقق من كل ملف في السحابة"
          }
        }
      }
    },
