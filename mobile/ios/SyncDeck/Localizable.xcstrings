    "Credentials are stored only in the local engine config on this iPhone and are never sent anywhere else.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik bilgileri yalnızca bu iPhone'daki yerel motor yapılandırmasında saklanır, hiçbir yere gönderilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten werden nur in der lokalen Engine-Konfiguration auf diesem iPhone gespeichert und nirgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales solo se guardan en la configuración local del motor en este iPhone y nunca se envían a ningún otro sitio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggegevens worden alleen in de lokale engineconfiguratie op deze iPhone bewaard en nergens anders heen gestuurd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据仅存储在此 iPhone 的本地引擎配置中，绝不会发送到其他地方。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報はこの iPhone のローカルエンジン設定にのみ保存され、他のどこにも送信されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётные данные хранятся только в локальной конфигурации движка на этом iPhone и никуда не отправляются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن بيانات الاعتماد في إعداد المحرك المحلي على هذا الـ iPhone فقط ولا تُرسل إلى أي مكان آخر."
          }
        }
      }
    },
