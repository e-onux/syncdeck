    "Moves files to the destination; files transferred successfully are deleted from the source.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları hedefe taşır; başarıyla aktarılanlar kaynaktan silinir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt Dateien ins Ziel; erfolgreich übertragene Dateien werden aus der Quelle gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve los archivos al destino; los transferidos con éxito se eliminan del origen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatst bestanden naar het doel; succesvol overgezette bestanden worden uit de bron verwijderd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件移动到目标；成功传输的文件会从源中删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを宛先へ移動します。転送に成功したファイルはソースから削除されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещает файлы в назначение; успешно переданные файлы удаляются из источника."
