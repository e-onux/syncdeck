    "Supported: filters (--exclude, --include, --max-age, --min-size…), --transfers, --checkers, --ignore-existing, --update, --size-only, --max-delete, --backup-dir and the toggles above.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenenler: filtreler (--exclude, --include, --max-age, --min-size…), --transfers, --checkers, --ignore-existing, --update, --size-only, --max-delete, --backup-dir ve yukarıdaki anahtarlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt: Filter (--exclude, --include, --max-age, --min-size…), --transfers, --checkers, --ignore-existing, --update, --size-only, --max-delete, --backup-dir und die Schalter oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibles: filtros (--exclude, --include, --max-age, --min-size…), --transfers, --checkers, --ignore-existing, --update, --size-only, --max-delete, --backup-dir y los interruptores de arriba."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondersteund: filters (--exclude, --include, --max-age, --min-size…), --transfers, --checkers, --ignore-existing, --update, --size-only, --max-delete, --backup-dir en de schakelaars hierboven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持：过滤器（--exclude、--include、--max-age、--min-size…）、--transfers、--checkers、--ignore-existing、--update、--size-only、--max-delete、--backup-dir 以及上方的开关。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応: フィルタ (--exclude, --include, --max-age, --min-size…)、--transfers、--checkers、--ignore-existing、--update、--size-only、--max-delete、--backup-dir と上のスイッチ。"
          }
        },
        "ru": {
