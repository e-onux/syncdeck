    "Keeps both locations in sync in both directions; the first run safely sets up a baseline (resync).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki konumu çift yönlü eşitler; ilk çalıştırmada güvenli kurulum (resync) yapılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält beide Orte in beide Richtungen synchron; der erste Lauf erstellt sicher einen Ausgangszustand (resync)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene ambas ubicaciones sincronizadas en ambos sentidos; la primera ejecución establece una base de forma segura (resync)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt beide locaties in beide richtingen gelijk; de eerste run zet veilig een basislijn op (resync)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双向同步两个位置；首次运行会安全地建立基线（resync）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方向に 2 つの場所を同期します。初回は安全にベースラインを作成します (resync)。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизирует оба расположения в обе стороны; первый запуск безопасно создаёт базовое состояние (resync)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي الموقعين متزامنين في الاتجاهين؛ ويُنشئ التشغيل الأول خط أساس بأمان (resync)."
          }
        }
      }
    },
