    "Delete client \"%@\"? This cannot be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" istemcisi silinsin mi? Bu işlem geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Client „%@“ löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el cliente «%@»? No se puede deshacer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Client \"%@\" verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除客户端“%@”？此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアント「%@」を削除しますか？元に戻せません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить клиента «%@»? Это нельзя отменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف العميل \"%@\"؟ لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
