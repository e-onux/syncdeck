    "Makes the destination an exact mirror of the source. Files missing from the source are deleted from the destination too.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefi kaynakla birebir aynalar. Kaynakta olmayan dosyalar hedefte de silinir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht das Ziel zum exakten Spiegel der Quelle. Dateien, die in der Quelle fehlen, werden auch im Ziel gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte el destino en un espejo exacto del origen. Los archivos que faltan en el origen también se eliminan del destino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt het doel een exacte spiegel van de bron. Bestanden die in de bron ontbreken, worden ook uit het doel verwijderd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使目标与源完全一致。源中不存在的文件也会从目标中删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宛先をソースと完全に同じにします。ソースにないファイルは宛先からも削除されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает назначение точной копией источника. Файлы, которых нет в источнике, удаляются и в назначении."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل الوجهة نسخة مطابقة تمامًا للمصدر. تُحذف من الوجهة أيضًا الملفات غير الموجودة في المصدر."
          }
        }
      }
    },
