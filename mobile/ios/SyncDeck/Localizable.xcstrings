    "Sign in in the browser sheet; SyncDeck stores the refreshed token in its local engine config.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı penceresinde oturum aç; SyncDeck yenilenen jetonu yerel motor yapılandırmasında saklar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich im Browserfenster an; SyncDeck speichert das erneuerte Token in der lokalen Engine-Konfiguration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en la ventana del navegador; SyncDeck guarda el token renovado en la configuración local del motor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in in het browservenster; SyncDeck bewaart het vernieuwde token in de lokale engineconfiguratie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器窗口中登录；SyncDeck 会将刷新后的令牌保存在本地引擎配置中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
