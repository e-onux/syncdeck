    "Session expired for %@. Re-authorize to keep syncing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için oturum süresi doldu. Senkronizasyonun sürmesi için yeniden yetkilendir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung für %@ ist abgelaufen. Autorisiere erneut, um weiter zu synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de %@ ha caducado. Vuelve a autorizar para seguir sincronizando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sessie voor %@ is verlopen. Autoriseer opnieuw om door te gaan met synchroniseren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的会话已过期。请重新授权以继续同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のセッションが期限切れです。同期を続けるには再認証してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс для %@ истёк. Авторизуйтесь снова, чтобы продолжить синхронизацию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة %@. أعد التفويض لمواصلة المزامنة."
          }
        }
      }
    },
