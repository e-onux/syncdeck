    "Free up space by moving photos and videos to your cloud, or keep a folder in sync.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolarını buluta taşıyarak yer aç ya da bir klasörü eşitle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Speicher frei, indem du Fotos und Videos in deine Cloud verschiebst, oder halte einen Ordner synchron."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio moviendo fotos y vídeos a tu nube, o mantén una carpeta sincronizada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak ruimte vrij door foto's en video's naar je cloud te verplaatsen, of houd een map gesynchroniseerd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片和视频移到云端以释放空间，或保持某个文件夹同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオをクラウドへ移して空き容量を増やすか、フォルダを同期しましょう。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите место, переместив фото и видео в облако, или синхронизируйте папку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفرغ مساحة بنقل الصور ومقاطع الفيديو إلى سحابتك، أو حافظ على مزامنة مجلد."
          }
        }
      }
    },
