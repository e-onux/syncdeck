    "Leave empty to use rclone's own client. Authorize in the browser; SyncDeck keeps the access token in its local engine config.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "rclone'un kendi istemcisini kullanmak için boş bırak. Tarayıcıda yetkilendir; SyncDeck erişim jetonunu yerel motor yapılandırmasında saklar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den eigenen Client von rclone zu nutzen. Autorisiere im Browser; SyncDeck speichert das Zugriffstoken in der lokalen Engine-Konfiguration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar el cliente propio de rclone. Autoriza en el navegador; SyncDeck guarda el token de acceso en la configuración local del motor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de eigen client van rclone te gebruiken. Autoriseer in de browser; SyncDeck bewaart het toegangstoken in de lokale engineconfiguratie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则使用 rclone 自带的客户端。在浏览器中授权后，SyncDeck 会将访问令牌保存在本地引擎配置中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄のままにすると rclone 独自のクライアントを使います。ブラウザで認証すると、SyncDeck はアクセストークンをローカルのエンジン設定に保存します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать собственный клиент rclone. Авторизуйтесь в браузере; SyncDeck хранит токен доступа в локальной конфигурации движка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغًا لاستخدام عميل rclone الخاص. فوّض في المتصفح؛ يحفظ SyncDeck رمز الوصول في إعداد المحرك المحلي."
          }
        }
      }
    },
