        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht geprüft, bleibt auf dem iPhone: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No verificado, se queda en el iPhone: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet gecontroleerd, blijft op iPhone: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未通过校验，保留在 iPhone 上：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証できなかったため iPhone に残します: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не проверено, остаётся на iPhone: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التحقق، يبقى على الـ iPhone: %@"
          }
        }
      }
    },
    "Nothing, move everything": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbirini, hepsini taşı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, alles verschieben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada, mover todo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets, alles verplaatsen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保留，全部移走"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残さない（すべて移動）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего, переместить всё"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء، انقل الكل"
          }
        }
      }
    },
    "On iPhone the engine is built into the app and updates with it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da motor uygulamanın içindedir ve onunla birlikte güncellenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone ist die Engine Teil der App und wird mit ihr aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone, el motor está integrado en la app y se actualiza con ella."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op iPhone zit de engine in de app en wordt deze ermee bijgewerkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上，引擎内置于应用中并随应用一起更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ではエンジンがアプリに組み込まれており、アプリと一緒に更新されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone движок встроен в приложение и обновляется вместе с ним."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPhone يكون المحرك مضمّنًا في التطبيق ويُحدَّث معه."
          }
        }
      }
    },
    "On this iPhone (SyncDeck folder)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'da (SyncDeck klasörü)"
          }
