    "%lld photos and videos are safely in your cloud and can be removed from this iPhone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotoğraf ve video bulutunda güvende, bu iPhone'dan kaldırılabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Fotos und Videos sind sicher in deiner Cloud und können von diesem iPhone entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotos y vídeos están a salvo en tu nube y se pueden quitar de este iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld foto's en video's staan veilig in je cloud en kunnen van deze iPhone worden verwijderd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张照片和视频已安全存入云端，可从此 iPhone 移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の写真とビデオはクラウドに安全に保存されており、この iPhone から削除できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld фото и видео надёжно сохранены в облаке и могут быть удалены с этого iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld صورة وفيديو محفوظة بأمان في سحابتك ويمكن إزالتها من هذا الـ iPhone."
          }
        }
      }
    },
