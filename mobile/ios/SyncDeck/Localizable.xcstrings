    "Runs scheduled profiles when you open SyncDeck and in the background when iOS grants time. Background App Refresh must be on for SyncDeck in iOS Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış profilleri SyncDeck'i açtığında ve iOS zaman tanıdığında arka planda çalıştırır. iOS Ayarları'nda SyncDeck için Arka Planda Uygulama Yenileme açık olmalı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt geplante Profile aus, wenn du SyncDeck öffnest, und im Hintergrund, wenn iOS Zeit gewährt. „Hintergrundaktualisierung“ muss für SyncDeck in den iOS-Einstellungen aktiviert sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta los perfiles programados al abrir SyncDeck y en segundo plano cuando iOS concede tiempo. La actualización en segundo plano debe estar activada para SyncDeck en Ajustes de iOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voert geplande profielen uit als je SyncDeck opent en op de achtergrond wanneer iOS tijd geeft. Ververs op achtergrond moet aan staan voor SyncDeck in de iOS-instellingen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在打开 SyncDeck 时以及 iOS 分配时间时在后台运行计划的配置文件。需要在 iOS 设置中为 SyncDeck 打开“后台App刷新”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SyncDeck を開いたとき、および iOS が時間を割り当てたときにバックグラウンドで、スケジュールされたプロファイルを実行します。iOS の設定で SyncDeck の「Appのバックグラウンド更新」をオンにしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает профили по расписанию при открытии SyncDeck и в фоне, когда iOS выделяет время. В настройках iOS для SyncDeck должно быть включено «Обновление контента»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل الملفات الشخصية المجدولة عند فتح SyncDeck وفي الخلفية عندما يمنح iOS وقتًا. يجب تفعيل تحديث التطبيقات في الخلفية لـ SyncDeck في إعدادات iOS."
          }
        }
      }
    },
