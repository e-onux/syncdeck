    "Photos and videos are stored in year and month folders, with their original names and dates.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve videolar, özgün adları ve tarihleriyle yıl ve ay klasörlerine kaydedilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Videos werden in Jahres- und Monatsordnern mit Originalnamen und -datum gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y vídeos se guardan en carpetas por año y mes, con sus nombres y fechas originales."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's en video's worden in jaar- en maandmappen opgeslagen, met hun oorspronkelijke namen en datums."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和视频按年和月分文件夹存放，保留原始名称和日期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とビデオは元の名前と日付のまま、年と月のフォルダに保存されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото и видео сохраняются в папки по годам и месяцам с исходными именами и датами."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الصور ومقاطع الفيديو في مجلدات حسب السنة والشهر بأسمائها وتواريخها الأصلية."
          }
        }
      }
    },
