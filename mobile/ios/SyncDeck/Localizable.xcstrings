    "Access to \"%@\" was lost. Pick the folder again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" erişimi kayboldu. Klasörü yeniden seç."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff auf „%@“ ging verloren. Wähle den Ordner erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió el acceso a «%@». Vuelve a elegir la carpeta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot \"%@\" is verloren. Kies de map opnieuw."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已失去对“%@”的访问权限。请重新选择该文件夹。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」へのアクセスが失われました。フォルダをもう一度選択してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к «%@» утрачен. Выберите папку снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُقد الوصول إلى \"%@\". اختر المجلد مرة أخرى."
          }
        }
      }
    },
