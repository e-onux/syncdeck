    "You sign in on %@'s own page. SyncDeck never sees your password; it keeps only an access key on this iPhone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumu %@ sayfasında açarsın. SyncDeck parolanı hiç görmez; bu iPhone'da yalnızca bir erişim anahtarı saklar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich auf der Seite von %@ an. SyncDeck sieht dein Passwort nie und speichert nur einen Zugriffsschlüssel auf diesem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicias sesión en la página de %@. SyncDeck nunca ve tu contraseña; solo guarda una clave de acceso en este iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je logt in op de pagina van %@. SyncDeck ziet je wachtwoord nooit en bewaart alleen een toegangssleutel op deze iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将在 %@ 自己的页面登录。SyncDeck 不会看到你的密码，只在此 iPhone 上保存访问密钥。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは %@ 自身のページで行います。SyncDeck がパスワードを見ることはなく、この iPhone にアクセスキーだけを保存します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы входите на странице %@. SyncDeck не видит ваш пароль и хранит на этом iPhone только ключ доступа."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجّل الدخول من صفحة %@ نفسها. لا يرى SyncDeck كلمة مرورك أبدًا، ويحتفظ بمفتاح وصول فقط على هذا الـ iPhone."
          }
        }
      }
    },
