    "Swipe right to run, left to delete.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalıştırmak için sağa, silmek için sola kaydır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach rechts wischen zum Ausführen, nach links zum Löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha para ejecutar y a la izquierda para eliminar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts om uit te voeren, naar links om te verwijderen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右轻扫运行，向左轻扫删除。"
