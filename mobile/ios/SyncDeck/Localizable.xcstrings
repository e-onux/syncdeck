    "A client named %@ already exists.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adında bir istemci zaten var."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Client namens %@ existiert bereits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un cliente llamado %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een client met de naam %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名为 %@ 的客户端已存在。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ という名前のクライアントは既に存在します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиент с именем %@ уже существует."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد عميل باسم %@ بالفعل."
          }
        }
      }
    },
    "A profile syncs a folder on this iPhone with a cloud location. Add a client first, then create a profile.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, bu iPhone'daki bir klasörü bir bulut konumuyla eşitler. Önce bir istemci ekle, sonra profil oluştur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil synchronisiert einen Ordner auf diesem iPhone mit einem Cloud-Speicherort. Füge zuerst einen Client hinzu und erstelle dann ein Profil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil sincroniza una carpeta de este iPhone con una ubicación en la nube. Primero añade un cliente y luego crea un perfil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een profiel synchroniseert een map op deze iPhone met een cloudlocatie. Voeg eerst een client toe en maak dan een profiel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件会将此 iPhone 上的文件夹与云端位置同步。请先添加客户端，再创建配置文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルはこの iPhone のフォルダをクラウド上の場所と同期します。まずクライアントを追加してから、プロファイルを作成してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль синхронизирует папку на этом iPhone с облачным расположением. Сначала добавьте клиента, затем создайте профиль."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزامن الملف الشخصي مجلدًا على هذا الـ iPhone مع موقع سحابي. أضف عميلًا أولًا، ثم أنشئ ملفًا شخصيًا."
          }
        }
      }
    },
