    "Choose the kind of cloud you want to connect. SyncDeck creates the matching configuration in the background.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanmak istediğin bulut türünü seç. SyncDeck arka planda uygun yapılandırmayı oluşturur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Cloud, die du verbinden möchtest. SyncDeck erstellt die passende Konfiguration im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el tipo de nube que quieres conectar. SyncDeck crea la configuración adecuada en segundo plano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies het soort cloud dat je wilt koppelen. SyncDeck maakt op de achtergrond de juiste configuratie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要连接的云类型。SyncDeck 会在后台创建相应的配置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続するクラウドの種類を選んでください。SyncDeck がバックグラウンドで適切な設定を作成します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите тип облака для подключения. SyncDeck создаст нужную конфигурацию в фоне."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نوع السحابة التي تريد ربطها. ينشئ SyncDeck الإعداد المناسب في الخلفية."
          }
        }
      }
    },
