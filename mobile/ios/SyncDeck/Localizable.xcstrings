    "Compares source and destination without writing anything and reports the differences.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey yazmadan kaynak ile hedefi karşılaştırır, farkları raporlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht Quelle und Ziel, ohne etwas zu schreiben, und meldet die Unterschiede."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara origen y destino sin escribir nada e informa de las diferencias."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkt bron en doel zonder iets te schrijven en rapporteert de verschillen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不写入任何内容的情况下比较源和目标，并报告差异。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も書き込まずにソースと宛先を比較し、差分を報告します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивает источник и назначение без записи и сообщает о различиях."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن المصدر والوجهة دون كتابة أي شيء ويبلغ عن الاختلافات."
          }
        }
      }
    },
