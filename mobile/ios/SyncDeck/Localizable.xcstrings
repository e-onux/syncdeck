    "%lld items could not be backed up and stay on the iPhone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe yedeklenemedi ve iPhone'da kalıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekte konnten nicht gesichert werden und bleiben auf dem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elementos no se pudieron copiar y siguen en el iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items konden niet worden geback-upt en blijven op de iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项无法备份，仍保留在 iPhone 上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件はバックアップできなかったため iPhone に残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld объектов не удалось сохранить, они остаются на iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر نسخ %lld عنصرًا وستبقى على الـ iPhone."
          }
        }
      }
    },
