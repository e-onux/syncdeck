    "Two-way sync could not compare both sides. Try again; the next run rebuilds its baseline.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çift yönlü eşitleme iki tarafı karşılaştıramadı. Tekrar dene; bir sonraki çalışma temel durumu yeniden kurar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bidirektionale Synchronisierung konnte die Seiten nicht vergleichen. Versuche es erneut; der nächste Lauf baut den Ausgangszustand neu auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización bidireccional no pudo comparar ambos lados. Inténtalo de nuevo; la próxima ejecución reconstruye la base."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tweerichtingssynchronisatie kon beide kanten niet vergelijken. Probeer het opnieuw; de volgende run bouwt de basislijn opnieuw op."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双向同步无法比较两侧。请重试；下次运行会重建基线。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "双方向同期で両側を比較できませんでした。もう一度試してください。次回の実行でベースラインを作り直します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двусторонняя синхронизация не смогла сравнить стороны. Попробуйте снова; следующий запуск восстановит базу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على المزامنة الثنائية مقارنة الجانبين. حاول مجددًا؛ سيعيد التشغيل التالي بناء خط الأساس."
          }
        }
      }
    },
