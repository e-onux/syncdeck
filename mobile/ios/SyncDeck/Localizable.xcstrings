    "On iPhone the engine is built into the app and updates with it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da motor uygulamanın içindedir ve onunla birlikte güncellenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone ist die Engine Teil der App und wird mit ihr aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone, el motor está integrado en la app y se actualiza con ella."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op iPhone zit de engine in de app en wordt deze ermee bijgewerkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上，引擎内置于应用中并随应用一起更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ではエンジンがアプリに組み込まれており、アプリと一緒に更新されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPhone движок встроен в приложение и обновляется вместе с ним."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPhone يكون المحرك مضمّنًا في التطبيق ويُحدَّث معه."
          }
        }
      }
    },
